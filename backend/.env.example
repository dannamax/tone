# ============================================================
# BountyApp Backend — Environment Variables Template
# Copy this file to `.env` and fill in real values.
# `.env` is loaded automatically at startup (via godotenv) and
# must NOT be committed to git.
# Process environment variables always override values here.
# ============================================================

# ---------- Server ----------
SERVER_PORT=8080

# ---------- Database ----------
# Driver: "sqlite" | "postgres"
DB_DRIVER=sqlite
DB_HOST=localhost
DB_PORT=5432
DB_USER=seeker
DB_PASSWORD=seeker123
DB_NAME=seekerdb.sqlite
DB_SSLMODE=disable

# ---------- Redis (optional, used for caching/rate-limit) ----------
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# ---------- JWT ----------
JWT_SECRET=change-me-to-a-long-random-string

# ---------- MinIO (object storage) ----------
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_USE_SSL=false
MINIO_PUBLIC_URL=http://localhost:9000

# ---------- Email / Verification Codes ----------
# Top-level mode: "smtp" (real send) | "mock" (log to console only, default)
EMAIL_PROVIDER=mock

# Domestic channel — start with a FREE personal mailbox SMTP.
# Example (QQ Mail): enable IMAP/SMTP in mailbox settings, then use an
# authorization code (NOT the login password) as SMTP_PASSWORD.
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USERNAME=your-qq@qq.com
SMTP_PASSWORD=your-mail-authorization-code
SMTP_FROM=your-qq@qq.com
SMTP_USE_TLS=true            # true = implicit TLS (port 465); false = STARTTLS (port 587)

# International channel — RESERVED for a paid professional service
# (Amazon SES / SendGrid / Postmark / Tencent or Aliyun Email Push / ...).
# Leave empty to route international recipients through the domestic channel.
# When set, Gmail/Outlook/iCloud/Yahoo/Proton addresses are sent via this channel.
SMTP_INTL_HOST=
SMTP_INTL_PORT=587
SMTP_INTL_USERNAME=
SMTP_INTL_PASSWORD=
SMTP_INTL_FROM=
SMTP_INTL_USE_TLS=false
